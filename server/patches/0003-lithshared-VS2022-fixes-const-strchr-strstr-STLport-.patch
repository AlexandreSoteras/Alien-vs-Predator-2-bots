From 74a0ccc87a2330dc621b46e3450c0b37d863c8df Mon Sep 17 00:00:00 2001
From: avp2bots <avp2bots@localhost>
Date: Tue, 10 Nov 2026 12:47:27 +0100
Subject: [PATCH] lithshared: VS2022 fixes (const strchr/strstr, STLport string
 hash, ios::nocreate, istrstream overload)
---
 LT2/lithshared/butemgr/butemgr.h           | 27 ++++++++++++++++++----
 LT2/lithshared/incs/butemgr.h              | 27 ++++++++++++++++++----
 LT2/lithshared_src/ButeMgr/butemgr.cpp     |  2 +-
 LT2/lithshared_src/MFCStub/mfcs_string.cpp |  4 ++--
 4 files changed, 49 insertions(+), 11 deletions(-)

diff --git a/LT2/lithshared/butemgr/butemgr.h b/LT2/lithshared/butemgr/butemgr.h
index 01307f2..e0e7271 100644
--- a/LT2/lithshared/butemgr/butemgr.h
+++ b/LT2/lithshared/butemgr/butemgr.h
@@ -52,6 +52,10 @@
 	#endif
 #endif
 
+// VS2022 port: the pre-standard iostreams' ios::nocreate no longer exists; a
+// standard ifstream never creates a missing file, so it maps to no flag.
+#define BM_IOS_NOCREATE ((std::ios_base::openmode)0)
+
 struct equal_str
 {
 	bool operator()(const char* s1, const char* s2) const
@@ -68,6 +72,21 @@ struct equal_str_nocase
 	}
 };
 
+// VS2022 port: the string dictionary below used STLport's std::hash<const char*>,
+// which hashes the characters. MSVC's std::hash<const char*> hashes the pointer,
+// so spell out STLport's string hash.
+struct hash_str
+{
+	unsigned long operator()(const char* str) const
+	{
+	  unsigned long hash = 0;
+	  for ( ; *str; ++str)
+		  hash = 5*hash + *str;
+
+	  return hash;
+	}
+};
+
 struct hash_str_nocase
 {
 	// Copied for stl-port's std::hash<const char*>.
@@ -299,7 +318,7 @@ private:
 
 	// Used to define dictionary of strings.
 	// This must be case sensitive!
-	typedef std::hash_set< CString, std::hash< char const* >, equal_str > StringHolder;
+	typedef std::hash_set< CString, hash_str, equal_str > StringHolder;
 
 	// Used to define map of strings to CSymTabItems.
 	typedef std::hash_map< char const*, CSymTabItem*, hash_str_nocase, equal_str_nocase > TableOfItems;
@@ -458,7 +477,7 @@ inline bool CButeMgr::Parse( istream& iCrypt, int nLen, const char* cryptKey)
 	ostrstream* pOss = new ostrstream(buf2, nLen);
 	m_cryptMgr.Decrypt(iCrypt, *pOss);
 
-	istrstream* pIStream = new istrstream(buf2, pOss->pcount());
+	istrstream* pIStream = new istrstream(buf2, (int)pOss->pcount()); // VS2022: pcount() is a streamsize, ambiguous overload
 
 	delete pOss;
 
@@ -551,7 +570,7 @@ inline bool CButeMgr::Parse(void* pData, unsigned long size, const char* cryptKe
 
 inline bool CButeMgr::Parse(CString sAttributeFilename, int decryptCode)
 {
-	ifstream* pIStream = new ifstream(sAttributeFilename, ios::in | ios::nocreate);
+	ifstream* pIStream = new ifstream(sAttributeFilename, ios::in | BM_IOS_NOCREATE);
 	if( !pIStream )
 		return false;
 	if (pIStream->fail())
@@ -574,7 +593,7 @@ inline bool CButeMgr::Parse(CString sAttributeFilename, int decryptCode)
 
 inline bool CButeMgr::Parse(CString sAttributeFilename, const char* cryptKey)
 {
-	ifstream* pIs = new ifstream(sAttributeFilename, ios::nocreate | ios::binary);
+	ifstream* pIs = new ifstream(sAttributeFilename, BM_IOS_NOCREATE | ios::binary);
 	if (!pIs)
 		return false;
 	if (pIs->fail())
diff --git a/LT2/lithshared/incs/butemgr.h b/LT2/lithshared/incs/butemgr.h
index 01307f2..e0e7271 100644
--- a/LT2/lithshared/incs/butemgr.h
+++ b/LT2/lithshared/incs/butemgr.h
@@ -52,6 +52,10 @@
 	#endif
 #endif
 
+// VS2022 port: the pre-standard iostreams' ios::nocreate no longer exists; a
+// standard ifstream never creates a missing file, so it maps to no flag.
+#define BM_IOS_NOCREATE ((std::ios_base::openmode)0)
+
 struct equal_str
 {
 	bool operator()(const char* s1, const char* s2) const
@@ -68,6 +72,21 @@ struct equal_str_nocase
 	}
 };
 
+// VS2022 port: the string dictionary below used STLport's std::hash<const char*>,
+// which hashes the characters. MSVC's std::hash<const char*> hashes the pointer,
+// so spell out STLport's string hash.
+struct hash_str
+{
+	unsigned long operator()(const char* str) const
+	{
+	  unsigned long hash = 0;
+	  for ( ; *str; ++str)
+		  hash = 5*hash + *str;
+
+	  return hash;
+	}
+};
+
 struct hash_str_nocase
 {
 	// Copied for stl-port's std::hash<const char*>.
@@ -299,7 +318,7 @@ private:
 
 	// Used to define dictionary of strings.
 	// This must be case sensitive!
-	typedef std::hash_set< CString, std::hash< char const* >, equal_str > StringHolder;
+	typedef std::hash_set< CString, hash_str, equal_str > StringHolder;
 
 	// Used to define map of strings to CSymTabItems.
 	typedef std::hash_map< char const*, CSymTabItem*, hash_str_nocase, equal_str_nocase > TableOfItems;
@@ -458,7 +477,7 @@ inline bool CButeMgr::Parse( istream& iCrypt, int nLen, const char* cryptKey)
 	ostrstream* pOss = new ostrstream(buf2, nLen);
 	m_cryptMgr.Decrypt(iCrypt, *pOss);
 
-	istrstream* pIStream = new istrstream(buf2, pOss->pcount());
+	istrstream* pIStream = new istrstream(buf2, (int)pOss->pcount()); // VS2022: pcount() is a streamsize, ambiguous overload
 
 	delete pOss;
 
@@ -551,7 +570,7 @@ inline bool CButeMgr::Parse(void* pData, unsigned long size, const char* cryptKe
 
 inline bool CButeMgr::Parse(CString sAttributeFilename, int decryptCode)
 {
-	ifstream* pIStream = new ifstream(sAttributeFilename, ios::in | ios::nocreate);
+	ifstream* pIStream = new ifstream(sAttributeFilename, ios::in | BM_IOS_NOCREATE);
 	if( !pIStream )
 		return false;
 	if (pIStream->fail())
@@ -574,7 +593,7 @@ inline bool CButeMgr::Parse(CString sAttributeFilename, int decryptCode)
 
 inline bool CButeMgr::Parse(CString sAttributeFilename, const char* cryptKey)
 {
-	ifstream* pIs = new ifstream(sAttributeFilename, ios::nocreate | ios::binary);
+	ifstream* pIs = new ifstream(sAttributeFilename, BM_IOS_NOCREATE | ios::binary);
 	if (!pIs)
 		return false;
 	if (pIs->fail())
diff --git a/LT2/lithshared_src/ButeMgr/butemgr.cpp b/LT2/lithshared_src/ButeMgr/butemgr.cpp
index 33a8a4e..fa4225c 100644
--- a/LT2/lithshared_src/ButeMgr/butemgr.cpp
+++ b/LT2/lithshared_src/ButeMgr/butemgr.cpp
@@ -1041,7 +1041,7 @@ bool CButeMgr::Save(const char* szNewFileName)
 
 	char buf[4096];
 
-	ifstream is(m_sAttributeFilename, ios::nocreate | ios::binary);	
+	ifstream is(m_sAttributeFilename, BM_IOS_NOCREATE | ios::binary);	
 
 	long nFileLength=0;
 	if (is.is_open())
diff --git a/LT2/lithshared_src/MFCStub/mfcs_string.cpp b/LT2/lithshared_src/MFCStub/mfcs_string.cpp
index b6bde36..5b30b9f 100644
--- a/LT2/lithshared_src/MFCStub/mfcs_string.cpp
+++ b/LT2/lithshared_src/MFCStub/mfcs_string.cpp
@@ -321,7 +321,7 @@ int CString::Find(char ch, DWORD start) const
 	if (start >= GetLength())
 		return -1;
 
-	char *pResult = strchr(&(GetBuffer()[start]), ch);
+	const char *pResult = strchr(&(GetBuffer()[start]), ch);
 
 	return (pResult) ? pResult - GetBuffer() : -1;
 }
@@ -331,7 +331,7 @@ int CString::Find(LPCTSTR pSub, DWORD start) const
 	if (start >= GetLength())
 		return -1;
 
-	char *pResult = strstr(&(GetBuffer()[start]), pSub);
+	const char *pResult = strstr(&(GetBuffer()[start]), pSub);
 
 	return (pResult) ? pResult - GetBuffer() : -1;
 }
